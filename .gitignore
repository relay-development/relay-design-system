node_modules/
dist/
site/
.DS_Store
*.log
.vite/
.netlify/
# .claude はローカル設定（settings.local.json 等）のみ無視し、以下は追跡する:
# agents / workflows（ローカル開発用の旧 sprint kit）、hooks（hardcode gate の正本 —
# 利用側へは get_setup が単体導入を案内）、settings.json（リポジトリ標準の hooks 配線）
.claude/*
!.claude/agents/
!.claude/workflows/
!.claude/hooks/
!.claude/settings.json
.wrangler/

# Lucide sprite copy for the dev server / preview site (regenerated by
# scripts/build-icons.mjs). The canonical copy lives in dist/.
examples/icons.svg

# Catalog pages are generated by scripts/build-pages.mjs from the shared
# template + examples/pages/*.html fragments. Sources tracked, output not.
examples/*.html

# Audited eval snapshots copied at build time (source of truth: evals/audited/)
examples/eval-outputs/

# Playwright MCP session artifacts (browser snapshots)
.playwright-mcp/

# Agent eval artifacts (generated UIs and score history; see evals/README.md)
evals/output/
evals/results/
