node_modules/
dist/
site/
.DS_Store
*.log
.vite/
.netlify/
# .claude はローカル設定（settings.local.json 等）のみ無視し、
# sprint kit の正本（agents / workflows — MCP get_sprint_kit が配布）は追跡する
.claude/*
!.claude/agents/
!.claude/workflows/
.wrangler/

# Lucide sprite copy for the dev server / preview site (regenerated by
# scripts/build-icons.mjs). The canonical copy lives in dist/.
examples/icons.svg

# Catalog pages are generated by scripts/build-pages.mjs from the shared
# template + examples/pages/*.html fragments. Sources tracked, output not.
examples/*.html

# Playwright MCP session artifacts (browser snapshots)
.playwright-mcp/
